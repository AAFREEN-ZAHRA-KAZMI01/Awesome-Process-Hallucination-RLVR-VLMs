/**
 * Creates the pilot-validation Google Form for Assignment 3 (Track A SLR).
 * HOW TO RUN: script.google.com -> New project -> paste this whole file -> Save -> select
 * "createPilotForm" -> Run -> allow permissions -> open View -> Logs (or Execution log) for the links.
 */
function createPilotForm() {
  var form = FormApp.create("Expert Validation of a Reward-Design Framework for Faithful Vision-Language Models");
  form.setDescription("This short survey (about 10 minutes) is part of a systematic literature review for the Research Methodology course (MG 3010) at FAST-NUCES, Islamabad. It asks for your opinion on a framework and six statements about reward design for vision-language models trained with reinforcement learning.\n\nParticipation is voluntary and you may stop at any time. No names or email addresses are collected. Responses are anonymous and will be reported only in aggregated form in this course paper.\n\nResearcher: Aafreen Zahra Kazmi (26I-7675), FAST-NUCES");
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage("Thank you for your time. Your response has been recorded anonymously.");

  // Section 1 - consent
  form.addCheckboxItem().setTitle("Consent").setChoiceValues(["I have read the information above and agree to take part."]).setRequired(true);

  // Section 2 - background
  form.addPageBreakItem().setTitle("Your background");
  form.addMultipleChoiceItem().setTitle("Role").setChoiceValues(["Faculty / researcher", "PhD student", "MS student", "BS student", "Industry ML engineer", "Other"]).setRequired(true);
  form.addMultipleChoiceItem().setTitle("Years of experience in machine learning").setChoiceValues(["Less than 1", "1-2", "3-5", "More than 5"]).setRequired(true);
  form.addMultipleChoiceItem().setTitle("Have you trained or fine-tuned a vision-language model or a large language model?").setChoiceValues(["Yes", "No"]).setRequired(true);
  form.addScaleItem().setTitle("How familiar are you with RL post-training of language models (RLHF, GRPO, RLVR)?").setBounds(1, 5).setLabels("Not familiar", "Very familiar").setRequired(true);

  // Section 3 - explanation + framework figure
  form.addPageBreakItem().setTitle("The framework").setHelpText("Process hallucination: a vision-language model gives the correct final answer, but its reasoning describes visual evidence that is wrong or not present in the image.\n\nModels trained with reinforcement learning are usually rewarded only for the final answer. The review classifies the fixes proposed in 66 studies on two axes:\n(a) What the reward checks: the final answer, perception (attention, regions, visual facts), or the reasoning text against the image.\n(b) Where the signal comes from: no extra model (rules, attention, counterfactuals), labelled evidence (regions or rationales), or an external model (judge LLM, rubric or trained reward model).\n\nThe figure below places the 63 primary studies on these axes. The highlighted cell is empty: no study checks the reasoning text against the image without a judge model or labels.");
  var blob = Utilities.newBlob(Utilities.base64Decode(IMG_B64), "image/png", "framework.png");
  form.addImageItem().setTitle("Framework: what the reward checks x where the signal comes from")
      .setImage(blob).setAlignment(FormApp.Alignment.CENTER).setWidth(740);

  // Section 4 - ratings
  form.addPageBreakItem().setTitle("Your ratings")
      .setHelpText("Please rate each statement. P1-P6 are propositions drawn from the review; F is the framework itself.");
  form.addGridItem().setTitle("How relevant is each statement to the problem of process hallucination?").setRows(["P1. Outcome-only rewards raise answer accuracy without guaranteeing that the model's reasoning uses the image.", "P2. The more directly a reward checks the reasoning text, the more it depends on a judge model, annotations or a trained reward model.", "P3. Judge-free training objectives improve perceptual grounding but do not check whether the written reasoning matches the image.", "P4. A lightweight text-image consistency signal (a frozen encoder, no judge) could recover part of the faithfulness gain of judge-based rewards at lower cost.", "P5. Reward methods cannot be fairly ranked from published results because backbones, data, benchmarks and cost reporting differ.", "P6. Faithfulness and computational cost should be reported alongside accuracy for a reward-design claim to be credible.", "F. The two-axis framework (what is checked x where the signal comes from) is a clear and useful way to classify reward designs."]).setColumns(["1 Not relevant", "2 Somewhat relevant", "3 Quite relevant", "4 Highly relevant"]).setRequired(true);
  form.addGridItem().setTitle("How much do you agree with each statement?").setRows(["P1. Outcome-only rewards raise answer accuracy without guaranteeing that the model's reasoning uses the image.", "P2. The more directly a reward checks the reasoning text, the more it depends on a judge model, annotations or a trained reward model.", "P3. Judge-free training objectives improve perceptual grounding but do not check whether the written reasoning matches the image.", "P4. A lightweight text-image consistency signal (a frozen encoder, no judge) could recover part of the faithfulness gain of judge-based rewards at lower cost.", "P5. Reward methods cannot be fairly ranked from published results because backbones, data, benchmarks and cost reporting differ.", "P6. Faithfulness and computational cost should be reported alongside accuracy for a reward-design claim to be credible.", "F. The two-axis framework (what is checked x where the signal comes from) is a clear and useful way to classify reward designs."]).setColumns(["1 Strongly disagree", "2 Disagree", "3 Neutral", "4 Agree", "5 Strongly agree"]).setRequired(true);

  // Section 5 - open questions
  form.addPageBreakItem().setTitle("Your views");
  form.addParagraphTextItem().setTitle("With a small compute budget and no labelled data, which kind of reward would you use to make a VLM's reasoning more faithful, and why?").setRequired(true);
  form.addParagraphTextItem().setTitle("Is any type of reward design missing from the framework? If yes, which?").setRequired(true);
  form.addParagraphTextItem().setTitle("Do current benchmarks (e.g., MathVista, HallusionBench) show whether a model's reasoning is faithful to the image? Why or why not?").setRequired(true);
  form.addParagraphTextItem().setTitle("Any other comment?").setRequired(false);

  // Responses go to a new Google Sheet
  var ss = SpreadsheetApp.create("Pilot responses - " + "Expert Validation of a Reward-Design Framework for Faithful Vision-Language Models");
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  Logger.log("SEND THIS LINK: " + form.getPublishedUrl());
  Logger.log("Edit the form: " + form.getEditUrl());
  Logger.log("Responses sheet: " + ss.getUrl());
}

var IMG_B64 = "";
