<mxfile host="app.diagrams.net" agent="26I-7675 SLR (geometry copied from the paper figures)"><diagram name="Fig. 1 Teaser" id="Fig__1_Teaser"><mxGraphModel dx="495" dy="201" grid="0" gridSize="10" page="1" pageScale="1" pageWidth="495" pageHeight="201" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#B2B2B2;strokeWidth=0.8;" vertex="1" parent="1"><mxGeometry x="10.4" y="12.7" width="130.9" height="125.2" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;html=1;fillColor=#8C8CFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.3" y="86.7" width="22.8" height="34.1" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#FFA64D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="64.5" y="46.8" width="22.8" height="74.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;html=1;fillColor=#66B266;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="98.6" y="72.4" width="22.8" height="48.4" as="geometry"/></mxCell><mxCell id="n_auto1" value="Image" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="47.4" y="10.0" width="56.8" height="28.1" as="geometry"/></mxCell><mxCell id="n_auto2" value="A" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="28.9" y="116.9" width="25.7" height="24.8" as="geometry"/></mxCell><mxCell id="n_auto3" value="B" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="63.4" y="116.9" width="24.8" height="24.8" as="geometry"/></mxCell><mxCell id="n_auto4" value="C" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="97.6" y="116.7" width="24.8" height="25.3" as="geometry"/></mxCell><mxCell id="n_r" value="&lt;b&gt;Q:&lt;/b&gt; Which bar is tallest?&lt;br&gt; &lt;b&gt;Reasoning:&lt;/b&gt; Bar A is &lt;font color=&#x27;#BF0000&#x27;&gt;red&lt;/font&gt;, bar C is &lt;font color=&#x27;#BF0000&#x27;&gt;striped&lt;/font&gt;, and bar B is the highest.&lt;br&gt; &lt;b&gt;Answer:&lt;/b&gt; B" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;strokeColor=#B2B2B2;fillColor=#FFFFFF;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="155.5" y="12.7" width="325.8" height="85.0" as="geometry"/></mxCell><mxCell id="n_auto5" value="Outcome reward &lt;i&gt;r&lt;/i&gt;&lt;sup&gt;acc&lt;/sup&gt; = 1 (answer correct) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; reasoning reinforced, although two of its visual claims are false (&lt;font color=&#x27;#BF0000&#x27;&gt;red&lt;/font&gt;)." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="10.4" y="143.6" width="475.1" height="47.9" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>