16.7" width="24.8" height="25.3" as="geometry"/></mxCell><mxCell id="n_r" value="&lt;b&gt;Q:&lt;/b&gt; Which bar is tallest?&lt;br&gt; &lt;b&gt;Reasoning:&lt;/b&gt; Bar A is &lt;font color=&#x27;#BF0000&#x27;&gt;red&lt;/font&gt;, bar C is &lt;font color=&#x27;#BF0000&#x27;&gt;striped&lt;/font&gt;, and bar B is the highest.&lt;br&gt; &lt;b&gt;Answer:&lt;/b&gt; B" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;strokeColor=#B2B2B2;fillColor=#FFFFFF;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="155.5" y="12.7" width="325.8" height="85.0" as="geometry"/></mxCell><mxCell id="n_auto5" value="Outcome reward &lt;i&gt;r&lt;/i&gt;&lt;sup&gt;acc&lt;/sup&gt; = 1 (answer correct) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;⇒&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; reasoning reinforced, although two of its visual claims are false (&lt;font color=&#x27;#BF0000&#x27;&gt;red&lt;/font&gt;)." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="10.4" y="143.6" width="475.1" height="47.9" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Fig. 2 Research design" id="Fig__2_Research_design"><mxGraphModel dx="476" dy="513" grid="0" gridSize="10" page="1" pageScale="1" pageWidth="476" pageHeight="513" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_p" value="&lt;b&gt;1 Planning&lt;/b&gt;: RQ1–RQ4, PICOC, protocol, IC/EC" style="rounded=1;absoluteArcSize=1;arcSize=6.0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=4;strokeColor=#737373;fillColor=#FFFFFF;fontFamily=Times New Roman;fontSize=16;" vertex="1" parent="1"><mxGeometry x="107.8" y="10.0" width="201.9" height="47.6" as="geometry"/></mxCell><mxCell id="n_s" value="&lt;b&gt;2 Search&lt;/b&gt;: 5 sources, strings S1–S3, validation on known papers" style="rounded=1;absoluteArcSize=1;arcSize=6.0;whiteSpa